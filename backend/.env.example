# Application
APP_NAME=FilmLog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=filmlog
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# DB_SOCKET=

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache and queue
CACHE_STORE=database
# CACHE_PREFIX=
QUEUE_CONNECTION=database

# JWT authentication
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=60
# JWT_REFRESH_TTL=20160
# JWT_BLACKLIST_ENABLED=true

# Gemini
# Create an API key at https://aistudio.google.com and choose a model that is
# available to your key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# CORS: comma-separated exact origins. "*" allows any origin.
CORS_ALLOWED_ORIGINS=*

# Framework variables that this API does not use (mail, Redis, AWS, Vite,
# broadcast, filesystem, etc.) are intentionally omitted. Laravel falls back
# to the defaults in config/.
